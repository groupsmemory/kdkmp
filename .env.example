# ============================================================================
# KDKMP JASASAJA — Environment Variables
# ============================================================================
# Free Tier Stack: Vercel Hobby + NeonDB Free + Upstash Free + Xendit Pay-per-Tx
# ============================================================================

# NeonDB PostgreSQL (Free Tier: 0.5GB, 100 concurrent connections)
# Dapatkan dari: https://console.neon.tech
NEON_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/kdkmp?sslmode=require"

# Upstash Redis (Free Tier: 10.000 commands/hari)
# Dapatkan dari: https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Xendit Payment Gateway (Pay-per-Transaction)
# Dapatkan dari: Xendit Dashboard > Settings > Callbacks
XENDIT_CALLBACK_TOKEN=""

# Meta Conversions API (CAPI)
# Dapatkan dari: Meta Events Manager > Settings > Conversions API
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
# Internal API key untuk proteksi endpoint (generate sendiri: openssl rand -hex 32)
META_CAPI_INTERNAL_KEY=""

# App Configuration
APP_URL="http://localhost:3000"

# Auth Secret (untuk JWT signing — generate: openssl rand -hex 32)
AUTH_SECRET=""

# Developer Dashboard Access Key (halaman /dev?key=xxx)
# Generate sendiri: bisa string apapun yang hanya Anda tahu
DEV_ACCESS_KEY="dev"
